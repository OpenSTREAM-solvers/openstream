{
  "Inputs.Model.writeInputFile": {
      "inputs":
         [
            {"name":"filePathName"  , "kind":"required",  "type":[["string","scalar"],["char"]],"purpose":"File pathname"},
            {"name":"ID"            , "kind":"required",  "type":[["string","scalar"],["char"],["integer","positive","scalar"]],"purpose":"Model ID "},
            {"name":"NNODES"        , "kind":"namevalue", "type":[["string","scalar"],["char"],["integer","positive","scalar"]],"purpose":"Number of axial nodes "},
            {"name":"FLUID"         , "kind":"namevalue", "type":[["string","scalar"],["char"]                                ],"purpose":"Fluid ID"},
            {"name":"PROPERTIES"    , "kind":"namevalue", "type":[["string","scalar"],["char"],["choices=string(enumeration('InputEnums.FLUIDPROPERTIES'))"]],"purpose":"Fluid property assumptions"},
            {"name":"ANGLE"         , "kind":"namevalue", "type":[["string","scalar"],["char"],["numeric","positive","scalar"]],"purpose":"Flow axis angle from vertical [deg]"},
            {"name":"FRICTION"      , "kind":"namevalue", "type":[["string","scalar"],["char"],["numeric"           ,"size=1,3"]],"purpose":"Wall friction coefficients"},
            {"name":"TPFM"          , "kind":"namevalue", "type":[["string","scalar"],["char"],["choices=string(enumeration('InputEnums.TPFM'))"]],"purpose":"Two-phase friction multiplier [-]"},
            {"name":"KLOC"          , "kind":"namevalue", "type":[["string","scalar"],["char"],["numeric","positive","size=1,:"]],"purpose":"Elevation of local perturbations [m] "},
            {"name":"KLOSS"         , "kind":"namevalue", "type":[["string","scalar"],["char"],["numeric","positive","size=1,:"]],"purpose":"corresponding pressure loss coefficients [-]"},
            {"name":"TPKM"          , "kind":"namevalue", "type":[["string","scalar"],["char"],["choices=string(enumeration('InputEnums.TPKM'))"]],"purpose":"Two-phase local loss multiplier [-] "},
            {"name":"THERMALNONEQ"  , "kind":"namevalue", "type":[["string","scalar"],["char"],["choices=string(enumeration('InputEnums.THERMALNONEQ'))"]],"purpose":"Thermal non-equilibrium model"},
            {"name":"VOID"          , "kind":"namevalue", "type":[["string","scalar"],["char"],["choices=string(enumeration('InputEnums.VOID'))"]],"purpose":"Void fraction model "},
            {"name":"SLIP"          , "kind":"namevalue", "type":[["string","scalar"],["char"],["numeric","positive","scalar"]],"purpose":"Phase velocity ratio [-]"},
            {"name":"OAF"           , "kind":"namevalue", "type":[["string","scalar"],["char"],["choices=string(enumeration('InputEnums.OAF'))"]],"purpose":"Onset of annular flow model [-]"},
            {"name":"OAFENTRAINED"  , "kind":"namevalue", "type":[["string","scalar"],["char"],["choices=string(enumeration('InputEnums.OAFENTRAINED'))"]],"purpose":"Entrained model at onset of annular flow [-]"},
            {"name":"OAFDROPRATIO"  , "kind":"namevalue", "type":[["string","scalar"],["char"],["numeric",">=0","<=1","scalar"]],"purpose":"Drop/Liquid mass ratio at onset of annular flow [-]"},
            {"name":"OAFTRANSITION" , "kind":"namevalue", "type":[["string","scalar"],["char"],["numeric","positive","size=1,2"]],"purpose":"Annular flow transition function parameters (sigmoid width/location wrt OAF) [m]"},
            {"name":"DEPOSITION"    , "kind":"namevalue", "type":[["string","scalar"],["char"],["choices=string(enumeration('InputEnums.DEPOSITION'))"]],"purpose":"Drop deposition model [-]"},
            {"name":"ENTRAINMENT"   , "kind":"namevalue", "type":[["string","scalar"],["char"],["choices=string(enumeration('InputEnums.MOMENTFILM'))"]],"purpose":"Film entrainment model [-]"},
            {"name":"MOMENTFILM"    , "kind":"namevalue", "type":[["string","scalar"],["char"],["choices=string(enumeration('InputEnums.OAFENTRAINED'))"]],"purpose":"Film momentum conservation model [-]"},
            {"name":"MOMENTDROP"    , "kind":"namevalue", "type":[["string","scalar"],["char"],["choices=string(enumeration('InputEnums.MOMENTDROP'))"]],"purpose":"Drop momentum conservation model [-]                                                                 "},
            {"name":"DROPSLIP"      , "kind":"namevalue", "type":[["string","scalar"],["char"],["numeric","positive","scalar"]],"purpose":"Drop velocity ratio [-]       "},
            {"name":"THINFILMFRIC"  , "kind":"namevalue", "type":[["string","scalar"],["char"],["choices=string(enumeration('InputEnums.THINFILMFRIC'))"]],"purpose":"Thin film friction model [-]"},
            {"name":"THINFILMTHICK" , "kind":"namevalue", "type":[["string","scalar"],["char"],["numeric","positive","scalar"]],"purpose":"Thin film thickness [m]"},
            {"name":"VAPORFRIC"     , "kind":"namevalue", "type":[["string","scalar"],["char"],["choices=string(enumeration('InputEnums.VAPORFRIC'))"]],"purpose":"Vapor friction model [-]"},
            {"name":"VAPORFRICCST"  , "kind":"namevalue", "type":[["string","scalar"],["char"],["numeric","positive","scalar"]],"purpose":"Vapor friction constant [-]"},
            {"name":"DROPDIAM"      , "kind":"namevalue", "type":[["string","scalar"],["char"]                                ],"purpose":"Thin film friction model [-]"},
            {"name":"DROPDRAG"      , "kind":"namevalue", "type":[["string","scalar"],["char"],["choices=string(enumeration('InputEnums.DROPDRAG'))"]],"purpose":"Drop diameter [mm]"},
            {"name":"DROPDRAGCOEF"  , "kind":"namevalue", "type":[["string","scalar"],["char"],["numeric","positive","scalar"]],"purpose":"Drop drag model"},
            {"name":"POSFILM"       , "kind":"namevalue", "type":[["string","scalar"],["char"],["logical", "choices={'TRUE','FALSE'}","scalar"]],"purpose":"Drop drag coefficient"}
         ]

  },
  "Inputs.Options.writeInputFile": {
      "inputs": 
          [
            {"name":"filePathName",  "kind":"required",  "type":[["string","scalar"],["char"]],"purpose":"File pathname"},
            {"name":"ID"            , "kind":"required", "type":[["string","scalar"],["char"],["integer","positive","scalar"]],"purpose":"Option ID "},
            {"name":"TSTEP"        , "kind":"namevalue", "type":[["string","scalar"],["char"],["numeric","positive","scalar"]],"purpose":"Time step [s]"},
            {"name":"MAXITER"      , "kind":"namevalue", "type":[["string","scalar"],["char"],["integer"           ,"scalar"]],"purpose":"Max number of inner (point) iterations"},
            {"name":"ERRORW"       , "kind":"namevalue", "type":[["string","scalar"],["char"],["numeric"           ,"scalar"]],"purpose":"Mass flow rate error target in inner iterations [kg/s]"},
            {"name":"ERRORP"       , "kind":"namevalue", "type":[["string","scalar"],["char"],["numeric"           ,"scalar"]],"purpose":"Pressure error target in inner ierations [Pa]"},
            {"name":"ERRORH"       , "kind":"namevalue", "type":[["string","scalar"],["char"],["numeric"           ,"scalar"]],"purpose":"Enthalpy error target in inner ierations [J/kg]"},
            {"name":"SSTSTEP"      , "kind":"namevalue", "type":[["string","scalar"],["char"],["numeric","positive","scalar"]],"purpose":"Time step for steady-state iterations [s]"},
            {"name":"SSMAXITER"    , "kind":"namevalue", "type":[["string","scalar"],["char"],["integer","positive","scalar"]],"purpose":"Max number of steady-state iterations"},
            {"name":"SSCONVW"      , "kind":"namevalue", "type":[["string","scalar"],["char"],["numeric"           ,"scalar"]],"purpose":"Mass flow rate steady-state convergence criterion [kg/s]"},
            {"name":"SSCONVP"      , "kind":"namevalue", "type":[["string","scalar"],["char"],["numeric"           ,"scalar"]],"purpose":"Pressure steady-state convergence criterion [Pa]"},
            {"name":"SSCONVH"      , "kind":"namevalue", "type":[["string","scalar"],["char"],["numeric"           ,"scalar"]],"purpose":"Enthalpy steady-state convergence criterion [J/kg]"},
            {"name":"AXIALINTERP"  , "kind":"namevalue", "type":[["string","scalar"],["char"]                                ],"purpose":"Axial power interpolation method"},
            {"name":"TIMEINTERP"   , "kind":"namevalue", "type":[["string","scalar"],["char"]                                ],"purpose":"Time-dependant boundary conditions interpolation method"},
            {"name":"RELAXWM"      , "kind":"namevalue", "type":[["string","scalar"],["char"],["numeric"           ,"scalar"]],"purpose":"Relaxation factor for the mixture mass conservation equation"},
            {"name":"RELAXPM"      , "kind":"namevalue", "type":[["string","scalar"],["char"],["numeric"           ,"scalar"]],"purpose":"Relaxation factor for the mixture momentum conservation equation"},
            {"name":"RELAXHM"      , "kind":"namevalue", "type":[["string","scalar"],["char"],["numeric"           ,"scalar"]],"purpose":"Relaxation factor for the mixture energy conservation equation"},
            {"name":"ERRORWF"      , "kind":"namevalue", "type":[["string","scalar"],["char"],["numeric"           ,"scalar"]],"purpose":"Film mass flow rate error target in inner iterations [kg/s/m]"},
            {"name":"ERRORUF"      , "kind":"namevalue", "type":[["string","scalar"],["char"],["numeric"           ,"scalar"]],"purpose":"Film velocity error target in inner iterations [m/s]"},
            {"name":"SSCONVWF"     , "kind":"namevalue", "type":[["string","scalar"],["char"],["numeric"           ,"scalar"]],"purpose":"Film mass flow rate steady-state convergence criterion [kg/s/m]"},
            {"name":"SSCONVUF"     , "kind":"namevalue", "type":[["string","scalar"],["char"],["numeric"           ,"scalar"]],"purpose":"Film velocity steady-state convergence criterion [m/s]"},
            {"name":"RELAXWF"      , "kind":"namevalue", "type":[["string","scalar"],["char"],["numeric",">=0","<=1","scalar"]],"purpose":"Relaxation factor for the film mass conservation equation"},
            {"name":"RELAXUF"      , "kind":"namevalue", "type":[["string","scalar"],["char"],["numeric",">=0","<=1","scalar"]],"purpose":"Relaxation factor for the film momentum conservation equation"}
          ]
  },
  "Inputs.BoundaryConditions.writeInputFile": {
      "inputs": 
          [
            {"name":"filePathName",  "kind":"required", "type":[["string","scalar"],["char"]],"purpose":"File pathname"},
            {"name":"TIME"       , "kind":"required",   "type":[["string","scalar"],["char"],["numeric","scalar"]],"purpose":"Time [s]"},
            {"name":"PRESSURE"   , "kind":"required",   "type":[["string","scalar"],["char"],["numeric","positive","scalar"]],"purpose":"System pressure [Pa]"},
            {"name":"HIN"        , "kind":"required",   "type":[["string","scalar"],["char"],["numeric","positive","scalar"]],"purpose":"Inlet enthalpy [J/kg]"},
            {"name":"MFLOW"      , "kind":"required",   "type":[["string","scalar"],["char"],["numeric","positive","scalar"]],"purpose":"Mass flow rate [kg/s]"},
            {"name":"POWER"      , "kind":"namevalue",  "type":[["string","scalar"],["char"],["numeric",">=0",     "scalar"]],"purpose":"Total power [W]"},
            {"name":"WMESH"      , "kind":"namevalue",  "type":[["string","scalar"],["char"],["numeric","positive","scalar"]],"purpose":"Relative power node size distribution [m]"},
            {"name":"WPOWER"     , "kind":"namevalue",  "type":[["string","scalar"],["char"],["numeric",">=0",     "scalar"]],"purpose":"Relative power distribution(s) [-] "}
          ]
  },
  "Inputs.Geometry.writeInputFile": {
      "inputs": 
          [
            {"name":"filePathName",  "kind":"required", "type":[["string","scalar"],["char"]],"purpose":"File pathname"},
            {"name":"ID"         , "kind":"required",   "type":[["string","scalar"],["char"],["integer","positive","scalar"]],"purpose":"Channel ID "},
            {"name":"LENGTH"     , "kind":"namevalue",  "type":[["string","scalar"],["char"],["numeric","positive","scalar"]],"purpose":"Axial length [m]"},
            {"name":"AREA"       , "kind":"namevalue",  "type":[["string","scalar"],["char"],["numeric","positive","scalar"]],"purpose":"Coolant area [m^2] "},
            {"name":"PERIM"      , "kind":"namevalue",  "type":[["string","scalar"],["char"],["numeric","positive","scalar"]],"purpose":"Perimeters [m]"},
            {"name":"ANGLE"      , "kind":"namevalue",  "type":[["string","scalar"],["char"],["numeric",           "scalar"]],"purpose":"Angle [rad] "}
          ]
  }
}
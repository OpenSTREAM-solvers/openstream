{
  "Inputs.Model.writeInputFile": {
      "inputs":
         [
            {"name":"filePathName",  "kind":"required", "type":["string","scalar"]},
            {"name":"ID"            , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"% Model ID "},
            {"name":"NNODES"        , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"% Number of axial nodes "},
            {"name":"FLUID"         , "kind":"namevalue", "type":[["string","scalar"]                                ],"purpose":"% Fluid ID"},
            {"name":"PROPERTIES"    , "kind":"namevalue", "type":[["string","scalar"]                                ],"purpose":"% Fluid property assumptions"},
            {"name":"ANGLE"         , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"% Flow axis angle from vertical [deg]"},
            {"name":"FRICTION"      , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","size=1,3"]],"purpose":"% Wall friction coefficients"},
            {"name":"TPFM"          , "kind":"namevalue", "type":[["string","scalar"]                                ],"purpose":"% Two-phase friction multiplier [-]"},
            {"name":"KLOC"          , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","size=1,:"]],"purpose":"% Elevation of local perturbations [m] "},
            {"name":"KLOSS"         , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","size=1,:"]],"purpose":"% corresponding pressure loss coefficients [-]"},
            {"name":"TPKM"          , "kind":"namevalue", "type":[["string","scalar"]                                ],"purpose":"% Two-phase local loss multiplier [-] "},
            {"name":"SCBOIL"        , "kind":"namevalue", "type":[["string","scalar"]                                ],"purpose":"% Subcooled boiling mode"},
            {"name":"VOID"          , "kind":"namevalue", "type":[["string","scalar"]                                ],"purpose":"% Void fraction model "},
            {"name":"SLIP"          , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"% Phase velocity ratio [-]"},
            {"name":"OAF"           , "kind":"namevalue", "type":[["string","scalar"]                                ],"purpose":"% Onset of annular flow model [-]"},
            {"name":"OAFDROPRATIO"  , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"% Drop/Liquid mass ratio at onset of annular flow [-]"},
            {"name":"OAFTRANSITION" , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","size=1,2"]],"purpose":"% Annular flow transition function parameters (sigmoid width/location wrt OAF) [m]"},
            {"name":"DEPOSITION"    , "kind":"namevalue", "type":[["string","scalar"]                                ],"purpose":"% Drop deposition model [-]"},
            {"name":"ENTRAINMENT"   , "kind":"namevalue", "type":[["string","scalar"]                                ],"purpose":"% Film entrainment model [-]   "},
            {"name":"MOMENTFILM"    , "kind":"namevalue", "type":[["string","scalar"]                                ],"purpose":"% Film momentum conservation model [-]  "},
            {"name":"MOMENTDROP"    , "kind":"namevalue", "type":[["string","scalar"]                                ],"purpose":"% Drop momentum conservation model [-]                                                                 "},
            {"name":"DROPSLIP"      , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"% Drop velocity ratio [-]       "},
            {"name":"THINFILMFRIC"  , "kind":"namevalue", "type":[["string","scalar"]                                ],"purpose":"% Thin film friction model [-]  "},
            {"name":"THINFILMTHICK" , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"% Thin film thickness [m]        "},
            {"name":"POSFILM"       , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"% Keep positive film flowrate/thickness"}
         ]

  },
  "Inputs.Options.writeInputFile": {
      "inputs": 
          [
            {"name":"filePathName",  "kind":"required", "type":["string","scalar"]},
            {"name":"ID"           , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Option ID "},
            {"name":"TSTEP"        , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Time step [s]"},
            {"name":"MAXITER"      , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Max number of inner (point) iterations"},
            {"name":"ERRORW"       , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Mass flow rate error target in inner iterations [kg/s]"},
            {"name":"ERRORP"       , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Pressure error target in inner ierations [Pa]"},
            {"name":"ERRORH"       , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Enthalpy error target in inner ierations [J/kg]"},
            {"name":"SSTSTEP"      , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Time step for steady-state iterations [s]"},
            {"name":"SSMAXITER"    , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Max number of steady-state iterations"},
            {"name":"SSCONVW"      , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Mass flow rate steady-state convergence criterion [kg/s]"},
            {"name":"SSCONVP"      , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Pressure steady-state convergence criterion [Pa]"},
            {"name":"SSCONVH"      , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Enthalpy steady-state convergence criterion [J/kg]"},
            {"name":"AXIALINTERP"  , "kind":"namevalue", "type":[["string","scalar"]                                ],"purpose":"Axial power interpolation method"},
            {"name":"TIMEINTERP"   , "kind":"namevalue", "type":[["string","scalar"]                                ],"purpose":"Time-dependant boundary conditions interpolation method"},
            {"name":"RELAXWM"      , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Relaxation factor for the mixture mass conservation equation"},
            {"name":"RELAXPM"      , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Relaxation factor for the mixture momentum conservation equation"},
            {"name":"RELAXHM"      , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Relaxation factor for the mixture energy conservation equation"},
            {"name":"ERRORWF"      , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Film mass flow rate error target in inner iterations [kg/s/m]"},
            {"name":"ERRORUF"      , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Film velocity error target in inner iterations [m/s]"},
            {"name":"SSCONVWF"     , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Film mass flow rate steady-state convergence criterion [kg/s/m]"},
            {"name":"SSCONVUF"     , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Film velocity steady-state convergence criterion [m/s]"},
            {"name":"RELAXWF"      , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Relaxation factor for the film mass conservation equation"},
            {"name":"RELAXUF"      , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Relaxation factor for the film momentum conservation equation"}
          ]
  },
  "Inputs.BoundaryConditions.writeInputFile": {
      "inputs": 
          [
            {"name":"filePathName",  "kind":"required", "type":["string","scalar"]},
            {"name":"TIME"       , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Time [s]"},
            {"name":"PRESSURE"   , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"System pressure [Pa]"},
            {"name":"HIN"        , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Inlet enthalpy [J/kg]"},
            {"name":"MFLOW"      , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Mass flow rate [kg/s]"},
            {"name":"POWER"      , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Total power [W]"},
            {"name":"WMESH"      , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Relative power node size distribution [m]"},
            {"name":"WPOWER"     , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Relative power distribution(s) [-] "}
          ]
  },
  "Inputs.Geometry.writeInputFile": {
      "inputs": 
          [
            {"name":"filePathName",  "kind":"required", "type":["string","scalar"]},
            {"name":"ID"         , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Channel ID"},
            {"name":"LENGTH"     , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Axial length [m]"},
            {"name":"AREA"       , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Coolant area [m^2] "},
            {"name":"PERIM"      , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Perimeters [m]"},
            {"name":"ANGLE"      , "kind":"namevalue", "type":[["string","scalar"],["integer","positive","scalar"]],"purpose":"Angle from vertical [deg]"}
          ]
  }
}
ID         ! Model ID                                                       > MFVALS
NNODES     ! Number of axial nodes                                          > 100
FLUID      ! Fluid ID                                                       > r245fa
PROPERTIES ! Fluid property assumptions                                     > saturated
FRICTION   ! Wall friction coefficients                                     > 0.2 -0.2 0.0
TPFM       ! Two-phase friction multiplier [-]                              > homogeneous
KLOC       ! Elevation of local perturbations [m]                           >
KLOSS      ! corresponding pressure loss coefficients [-]                   >
TPKM       ! Two-phase local loss multiplier [-]                            > homogeneous
SCBOIL     ! Subcooled boiling model                                        > none
VOID       ! Void fraction model                                            > homogeneous
SLIP       ! Phase velocity ratio [-]                                       > 1
OAF        ! Onset of annular flow model                                    > WALLIS_SIMP
OAFDROPRATIO ! Drop/Liquid mass flow ratio at onset of annular flow         > 0.3
OAFENTRAINED ! Drop/Liquid mass flow ratio at onset of annular flow         > EQUILIBRIUM
OAFTRANSITION !  % Annular flow transition function parameters  [m]         > [0.04 0.0]
MOMENTFILM !                                                                > ALGEBRAIC
MOMENTDROP !                                                                > FULL
DROPSLIP !                                                                  > 1.0
DEPOSITION !                                                                > OKAWA
ENTRAINMENT !                                                               > OKAWA
THINFILMFRIC ! % Thin film thickness [m]                                    > LAMINAR
POSFILM !                                                                   > 0
END

ID         ! Model ID                                                       > MFVALP
NNODES     ! Number of axial nodes                                          > 100
FLUID      ! Fluid ID                                                       > r245fa
PROPERTIES ! Fluid property assumptions                                     > psystem
FRICTION   ! Wall friction coefficients                                     > 0.2 -0.2 0.0
TPFM       ! Two-phase friction multiplier [-]                              > homogeneous
KLOC       ! Elevation of local perturbations [m]                           >
KLOSS      ! corresponding pressure loss coefficients [-]                   >
TPKM       ! Two-phase local loss multiplier [-]                            > homogeneous
SCBOIL     ! Subcooled boiling model                                        > none
VOID       ! Void fraction model                                            > homogeneous
SLIP       ! Phase velocity ratio [-]                                       > 1
MOMENTFILM !                                                                > FULL
END


ID         ! Model ID                                                       > BARCS
NNODES     ! Number of axial nodes                                          > 100
FLUID      ! Fluid ID                                                       > water
PROPERTIES ! Fluid property assumptions                                     > saturated

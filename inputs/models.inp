SCBOIL     ! Subcooled boiling model                                        > none
VOID       ! Void fraction model                                            > slip
SLIP       ! Phase velocity ratio [-]                                       > 1.
OAFDROPRATIO ! Drop/Liquid mass flow ratio at onset of annular flow         > 0.5
OAF        ! Onset of annular flow model                                    > WALLIS_SIMP
END


@article{BESTION1990229,
title = {The physical closure laws in the CATHARE code},
journal = {Nuclear Engineering and Design},
volume = {124},
number = {3},
pages = {229-245},
year = {1990},
issn = {0029-5493},
doi = {https://doi.org/10.1016/0029-5493(90)90294-8},
url = {https://www.sciencedirect.com/science/article/pii/0029549390902948},
author = {D. Bestion},
abstract = {CATHARE is a 2-fluid thermal-hydraulic code capable of simulating thermal and mechanical phenomena occurring in the primary and secondary circuits of PWRs for a wide variety of accidental situations. The description of the flow is essentially 1-dimensional. Closure laws concerning mass, momentum and energy exchanges between phases and between each phase and the walls are required. A set of specifically designed separate effect experiments were performed and analysed. Having regard for some development principles, correlations are established on the basis of experimental data. The mechanical transfer laws are derived first from experiments where thermal non equilibrium is negligible. Using them as a basis for further interpretation of experimental data, interfacial heat transfer laws are then developed. Wall heat transfer correlations then have to be fixed. All these steps are presented with emphasis being placed on the most recent developments. These last investigations concern the direct contact condensation, stratification model, wall friction, droplet break up and the scale effect, geometrical effect and pressure effect on interfacial friction.
Zusammenfassung
CATHARE est un code de thermohydraulique á deux fluides capable de simuler le comportement mécanique et thermique des circuits primaire et secondaire des Réacteurs à Eau Pressurisée dans une grande variété de situations accidentelles. La description des écoulements est essentiellement monodimensionnelle. Des lois de fermeture sont nécessaires pour exprimer les transferts de masse, énergie et quantité de mouvement entre phases et avec les parois. Pour cela des expériences á effets sépares ont été réalisées et anayés. Des corrélations sont établies sur la base de ces essais en suivant certains principes de développement. Les lois concernant les transferts mécaniques sont établies en premier a partir d'expériences ou ale deséquilibre thermique est négligeable. Elles sont ensuite utilisees pour interpreter d'autres données qui servent a determiner les transferts interfaciaux. Enfin les transferts de chaleur avec les parois sont modélisés. Toutes ces etapes sont presentees en insistant sur les plus récents developpements. Ceux-ci concernant la condensation par contact direct, la stratification, le frottement paroi, le fractionnement de gouttes ainsi que les effets d'echelle, de geometrie et de pression sur le frottement interfacial.}
}

